        {
          "id": "813a2cba-295d-40d2-9cb1-fe4ad638f1dd",
          "name": "Updates a person's profile picture with support for upload and set modes.",
          "request": {
            "name": "Updates a person's profile picture with support for upload and set modes.",
            "description": {
              "content": "<strong>Two modes of operation:</strong>\n\n<strong>1. Upload Mode:</strong> When no request body is provided, returns a presigned URL for direct image upload to S3. Use a PUT request to upload your image file to the returned signed URL.\n\n<strong>2. Set Mode:</strong> When a request body with ImageUrl is provided, sets the profile picture to the specified URL<br/><strong>Permissions</strong><br/>Person: Write<br/>HourlyProfile: Write",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rp",
                "api",
                "v1",
                "accounts",
                ":accountId",
                "persons",
                ":personId",
                "profile-picture"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],

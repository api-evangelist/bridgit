            "method": "GET",
            "url": "https://bench.gobridgit.com/rp/api/v1/accounts/:accountId/persons/:personId/certifications/:certId/attachments/:id",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "The account ID"
              },
              {
                "name": "personId",
                "value": "",
                "type": "path",
                "description": "The person ID"
              },
              {
                "name": "certId",
                "value": "",
                "type": "path",
                "description": "The certification ID"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The attachment ID"
              }

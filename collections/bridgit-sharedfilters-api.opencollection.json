{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bench AccountActivities SharedFilters API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "SharedFilters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Delete a shared filter from the given account",
            "type": "http"
          },
          "http": {

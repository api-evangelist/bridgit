            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "The Account ID"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id of the filter to remove"
              }
            ]
          },
          "docs": "<br/><strong>Permissions</strong><br/>Account: Write"
        }
      ]
    }
  ],
  "bundled": true
}